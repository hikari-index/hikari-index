#!/bin/bash
# Run by init-hikari as the programs' user: the folders inside the three
# mounts, and on the first start the secrets.
set -euo pipefail

log() { echo "[hikari] $*"; }
fail() { echo "[hikari] cannot start: $*" >&2; exit 1; }

for dir in /config /data /images; do
    [ -w "$dir" ] || fail "user $(id -u) cannot write to $dir"
done
mkdir -p /data/runs /config/db /config/backups /config/worker-tokens
chmod 0700 /config/db
chmod 0750 /config/backups /config/worker-tokens
[ -w /data/runs ] || fail "user $(id -u) cannot write to /data/runs"
echo "$(id -u):$(id -g)" > /config/.owner.new
mv /config/.owner.new /config/.owner

if [ -s /config/db/PG_VERSION ] && [ "$(cat /config/db/PG_VERSION)" != 18 ]; then
    fail "the database in /config/db was made by PostgreSQL $(cat /config/db/PG_VERSION) and this image runs 18; go back to the image that made it"
fi
# A container that was killed (a stop that ran out of time, a power cut)
# leaves the database's lock file behind, naming a process number. In the
# next container that number can belong to another program, and the
# database then refuses to start for as long as that program lives.
# Nothing of this container's is running yet, so a lock file found here is
# always a leftover. (The database image never meets this: its database
# is always process 1.)
rm -f /config/db/postmaster.pid

# The secrets: the same ones, made the same way, as the compose install's
# first-run step (the gallery's own script), kept in /config/hikari.env.
# An empty file /config/reset-admin-password makes a new admin sign-in.
secrets=/config/hikari.env
make_secrets() {
    # The name is yours if you set one; left empty, the script's own
    # default stands, as on a compose install.
    node /opt/hikari/gallery/scripts/first-run.js "${HIKARI_ADMIN_USER:-}"
}
show_password() {
    user="$(printf '%s\n' "$1" | sed -n 's/^  user:     //p')"
    password="$(printf '%s\n' "$1" | sed -n 's/^  password: //p')"
    [ -n "$user" ] && [ -n "$password" ] || fail "the first-run script printed no sign-in"
    log "================================================================"
    log "Your admin sign-in. Only a hash of the password is kept: the"
    log "password itself is in this log and nowhere else, and the log goes"
    log "when the container is removed or updated. Write it down now."
    log "  user:     $user"
    log "  password: $password"
    log "To make a new one later, put an empty file named"
    log "reset-admin-password in the config folder and restart."
    log "================================================================"
}
umask 077
if [ ! -s "$secrets" ]; then
    [ ! -e /config/db/PG_VERSION ] || fail "/config/hikari.env is missing but /config/db holds a database made with its password; put the file back"
    out="$(make_secrets)"
    printf '%s\n' "$out" | grep -E '^HIKARI_[A-Z_]+=' > "$secrets.new"
    mv "$secrets.new" "$secrets"
    show_password "$out"
elif [ -e /config/reset-admin-password ]; then
    out="$(make_secrets)"
    { grep -Ev '^HIKARI_(ADMIN_USER|ADMIN_PASSWORD_HASH|SESSION_SECRET)=' "$secrets"
      printf '%s\n' "$out" | grep -E '^HIKARI_(ADMIN_USER|ADMIN_PASSWORD_HASH|SESSION_SECRET)='
    } > "$secrets.new"
    mv "$secrets.new" "$secrets"
    rm /config/reset-admin-password
    show_password "$out"
fi
chmod 0600 "$secrets"
# Every start, not only the first: a file restored from an old copy or
# edited by hand with a line lost would otherwise stop the programs one
# by one with nothing said.
for key in HIKARI_DB_PASSWORD HIKARI_ADMIN_USER HIKARI_ADMIN_PASSWORD_HASH HIKARI_SESSION_SECRET HIKARI_ANALYZE_TOKEN; do
    [ "$(grep -c "^$key=" "$secrets")" = 1 ] && grep -q "^$key=." "$secrets" \
        || fail "hikari.env in the config folder must have exactly one $key line, with a value; put back the file this install was made with"
done

# The analyze worker's token, where an analyze container on this host can
# read it (HIKARI_WORKER_TOKEN_FILE) with nothing pasted. Written beside
# and renamed in, and left alone when already right, so a worker starting
# at the same moment never reads half a file.
umask 027
token="$(sed -n 's/^HIKARI_ANALYZE_TOKEN=//p' "$secrets")"
if [ "$(cat /config/worker-tokens/analyze 2>/dev/null || true)" != "$token" ]; then
    printf '%s' "$token" > /config/worker-tokens/analyze.new
    mv /config/worker-tokens/analyze.new /config/worker-tokens/analyze
fi

# The analyze worker beside this container reads the token made here, so
# a different token for the name analyze in HIKARI_WORKER_TOKENS cannot
# work. The same pair is fine.
others="$(printf '%s' "${HIKARI_WORKER_TOKENS:-}" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -vxF "analyze:$token" || true)"
if printf '%s\n' "$others" | grep '^analyze:' > /dev/null; then
    fail "HIKARI_WORKER_TOKENS gives the name analyze a different token from the one this container made; remove that pair (the container's own is in worker-tokens/analyze in the config folder)"
fi

if [ -f /config/shoko-api-key ] && [ ! -L /config/shoko-api-key ]; then
    chmod 0400 /config/shoko-api-key
fi
