#!/command/with-contenv bash
# The database. Made on the first start in /config/db; reachable only from
# inside this container (the local socket, and 127.0.0.1 with the password).
# It runs with the locale the postgres image has and no time zone of
# yours, so it keeps UTC as the compose install's database does.
set -euo pipefail
. /opt/hikari/aio/env

database() { s6-setuidgid hikari env -i HOME=/home/hikari PATH="$PGBIN:/usr/sbin:/usr/bin:/sbin:/bin" LANG=en_US.UTF-8 "$@"; }

if [ ! -s /config/db/PG_VERSION ]; then
    log "making the database in /config/db"
    pwfile="$(mktemp)"
    printf '%s' "$HIKARI_DB_PASSWORD" > "$pwfile"
    chown hikari "$pwfile"
    database initdb --pgdata=/config/db --username=hikari --pwfile="$pwfile" \
        --auth-local=trust --auth-host=scram-sha-256 --encoding=UTF8 --locale=en_US.UTF-8 > /dev/null
    rm "$pwfile"
fi

exec s6-setuidgid hikari env -i HOME=/home/hikari PATH="$PGBIN:/usr/sbin:/usr/bin:/sbin:/bin" LANG=en_US.UTF-8 \
    postgres -D /config/db -c listen_addresses=127.0.0.1 -c unix_socket_directories=/run/postgresql
