# Sourced by the programs' start scripts: the settings made on first start
# plus the fixed places things live in this image.
#
# /config/hikari.env is read as data, never run: these scripts are root
# until they hand over to the program, and the file sits in a folder the
# programs' user can write.
while IFS= read -r line || [ -n "$line" ]; do
    case "${line%%=*}" in
        HIKARI_DB_PASSWORD|HIKARI_ADMIN_USER|HIKARI_ADMIN_PASSWORD_HASH|HIKARI_SESSION_SECRET|HIKARI_ANALYZE_TOKEN)
            export "${line%%=*}=${line#*=}" ;;
    esac
done < /config/hikari.env
export DATABASE_URL="postgres://hikari:${HIKARI_DB_PASSWORD}@127.0.0.1:5432/hikari"
export HIKARI_IMAGES=/images
export PGHOST=/run/postgresql PGUSER=hikari PGDATABASE=hikari
PGBIN=/usr/lib/postgresql/18/bin

log() { echo "[hikari] $*"; }
# Anything that writes under /config, /data or /images does it as the
# programs' user, never as root.
as_user() { s6-setuidgid hikari "$@"; }
