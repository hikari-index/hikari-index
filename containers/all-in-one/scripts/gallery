#!/command/with-contenv bash
# The gallery, as the gallery image runs it. The environment below is
# what compose.yaml's gallery service gives it (the settings, one per
# line, same names and defaults) and what the gallery image itself sets
# (gallery/Dockerfile's ENV), with this container's addresses and
# folders.
set -euo pipefail
. /opt/hikari/aio/env

cd /opt/hikari/gallery
program \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    NODE_ENV=production PORT=3000 HOST=0.0.0.0 BODY_SIZE_LIMIT=64M HIKARI_READ_ONLY= \
    HIKARI_GALLERY_VERSION="$HIKARI_GALLERY_VERSION" \
    DATABASE_URL="$DATABASE_URL" \
    ORIGIN="${HIKARI_ORIGIN:-}" \
    HIKARI_ADMIN_USER="$HIKARI_ADMIN_USER" \
    HIKARI_ADMIN_PASSWORD_HASH="$HIKARI_ADMIN_PASSWORD_HASH" \
    HIKARI_SESSION_SECRET="$HIKARI_SESSION_SECRET" \
    HIKARI_WORKER_TOKENS="analyze:${HIKARI_ANALYZE_TOKEN}${HIKARI_WORKER_TOKENS:+,${HIKARI_WORKER_TOKENS}}" \
    HIKARI_ADMIN_LINK="${HIKARI_ADMIN_LINK:-1}" \
    HIKARI_NOTICE="${HIKARI_NOTICE:-}" \
    TZ="${HIKARI_TZ:-${TZ:-}}" \
    HIKARI_SHOKO_BASE_URL="${HIKARI_SHOKO_BASE_URL:-}" \
    HIKARI_IMAGES=/images \
    HIKARI_RUNS=/data/runs \
    ENCODER_URL=http://127.0.0.1:5187 \
    HIKARI_SHOKO_API_KEY_FILE=/config/shoko-api-key \
    node build
