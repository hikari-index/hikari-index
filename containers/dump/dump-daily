#!/bin/bash
# One dump of the database a day into a folder, fourteen kept.
# compose.yaml's `backup` service runs it from the database image.
#
#   dump-daily <folder>
#
# The database is found through the usual PG* variables (PGHOST, PGUSER,
# PGDATABASE, and PGPASSWORD where one is needed). Files are named
# hikari-YYYY-MM-DD.dump by the UTC date, in pg_dump's custom format
# (restore with pg_restore). It looks hourly, so an install that was off
# at the usual hour still gets its dump. A database with no tables yet
# (a new install before the gallery's first start) is not dumped; it
# looks again every minute until there are some.
#
# A dump on the same disk as the database guards against a bad update or
# a mistake, not a dead disk: copy the folder somewhere else as well.
set -uo pipefail
# A dump holds the whole database: readable by whoever runs this, no one else.
umask 077

dir="${1:?usage: dump-daily <folder>}"
log() { echo "[backup] $*"; }
# A stop ends the wait at once instead of after the hour.
trap 'exit 0' TERM INT

[ -d "$dir" ] && [ -w "$dir" ] || { log "cannot write to $dir as user $(id -u); no dumps will be made until it is writable"; }
# A dump that was cut short (a stop, a full disk) is not a dump. Each
# run writes under a name of its own, so a second one started on the same
# folder by mistake can remove this one's unfinished file (its dump then
# fails and says so) but never publish it as finished.
rm -f "$dir"/*.dump.part* 2>/dev/null
mine="part.$(hostname).$$"

while true; do
    pause=3600
    dump="$dir/hikari-$(date -u +%F).dump"
    if [ ! -s "$dump" ]; then
        if ! tables="$(psql -tAc "select count(*) from information_schema.tables where table_schema = 'public'" 2>&1)"; then
            log "today's database dump: the database did not answer ($(printf '%s' "$tables" | tail -n 1)); trying again in an hour"
        elif ! [ "$tables" -ge 0 ] 2>/dev/null; then
            log "today's database dump: could not tell whether the database has tables yet (it said: $(printf '%s' "$tables" | tail -n 1)); trying again in an hour"
        elif [ "$tables" -gt 0 ]; then
            if pg_dump --format=custom --file="$dump.$mine" && mv "$dump.$mine" "$dump"; then
                # Fourteen kept: by the date in the name, daily dumps only,
                # and safe for a folder or file name with a space in it.
                find "$dir" -maxdepth 1 -type f -name 'hikari-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].dump' -print0 \
                    | sort -z -r | tail -z -n +15 | xargs -0 -r rm --
                log "database dumped to $dump"
            else
                rm -f "$dump.$mine"
                log "today's database dump failed (is the folder's disk full, and can user $(id -u) write to $dir?); trying again in an hour"
            fi
        else
            pause=60
        fi
    fi
    sleep "$pause" &
    wait $!
done
