# .env: the settings compose.yaml reads. Copy this file to `.env` (it is
# git-ignored) and fill in the first section. The secrets at the bottom
# are made for you by the first-run step in the README.

# --- yours to set -------------------------------------------------------

# The folder your video is in. Mounted read-only into the one worker that
# reads it; nothing else sees it.
HIKARI_VIDEO=/path/to/your/video

# The address you will open the gallery at. The admin sign-in refuses
# forms from any other address, so from another computer on your network
# this must be the server's address, not localhost.
HIKARI_ORIGIN=http://localhost:5183

# Which analyze worker runs here: `cpu` works anywhere and is slow (about
# four minutes an episode); `gpu` needs an NVIDIA card and the NVIDIA
# container toolkit (about two and a half).
COMPOSE_PROFILES=cpu

# --- optional -----------------------------------------------------------

# HIKARI_GALLERY_PORT=5183
# HIKARI_GALLERY_BIND=0.0.0.0

# Where things are kept. Left unset, each is a Docker volume. Set one to
# a path and it is a folder of yours instead. The data and images
# folders must be writable by user id 10001; the database sets up its
# own folder (the docs' Backups page says why you might want paths:
# https://docs.hikari-index.moe/run/backups/).
# HIKARI_DB_DATA=/path/to/hikari/db
# HIKARI_DATA=/path/to/hikari/data
# HIKARI_IMAGES=/path/to/hikari/images

# Shoko (https://docs.hikari-index.moe/install/shoko/ walks through it; read-only,
# a non-admin API key).
# Put the key, alone, in a file
# named `shoko-api-key` in the folder HIKARI_SECRETS names (default
# ./secrets), readable by user id 10001. With Shoko, name the source
# folder by Shoko's managed folder id, e.g. HIKARI_SOURCE_ROOTS=4=/source
# HIKARI_SHOKO_BASE_URL=http://192.0.2.20:8111
# HIKARI_SECRETS=./secrets
# HIKARI_SOURCE_ROOTS=library=/source

# "1" makes this machine's analyze worker a fallback for one on another
# machine (https://docs.hikari-index.moe/install/second-machine/).
# HIKARI_ANALYZE_STANDBY=1

# Only start the worker's stages (extraction, web images, deletions)
# between these hours, e.g. 01-07. A stage already running finishes.
# The hours are the container's clock, which is UTC.
# HIKARI_WORKER_HOURS=

# The "Admin" link in the page header. Set to 0 for an install the
# public can reach (docs/HOW_IT_WORKS.md).
# HIKARI_ADMIN_LINK=1

# What the built images call themselves.
# HIKARI_VERSION=local

# --- made by the first-run step; paste its lines below ------------------
