# .env.rtx-worker: read by compose.rtx-worker.yaml only (a GPU analyze
# worker on a second machine; https://docs.hikari-index.moe/install/second-machine/), passed as --env-file. Copy to `.env.rtx-worker` (git-ignored)
# and fill in.
#
# The gallery. An IP address avoids a name lookup on every connection.
HIKARI_GALLERY_URL=http://192.0.2.10:5183
# This machine's own token: the gallery's HIKARI_WORKER_TOKENS holds it as
# "<HIKARI_WORKER_ID>:<token>" (32+ random characters; good only for that
# name).
HIKARI_WORKER_TOKEN=change-me-to-this-workers-token
# This worker's name on the Jobs page.
HIKARI_WORKER_ID=gpu
# What the built image calls itself (hikari-index/rtx-worker:<this>) and
# reports on the Jobs page. Set it before building.
HIKARI_WORKER_VERSION=rtx-worker-local
