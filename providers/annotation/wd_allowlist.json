  "policy": {
    "matching": "exact tag name only, never substring or pattern",
    "matching_reason": "Substring matching on this vocabulary is actively dangerous. A search for 'bloom' returns 'bloomers' (clothing), 'shadow' returns 'eyeshadow' (cosmetics), and 'dark' returns 'dark_skin' and 'dark-skinned_female' -- demographic descriptors that must never reach a record.",
    "default": "discard",
    "default_reason": "A tag earns a place only by naming a taxonomy value it can land on. Everything else is discarded, including tags that look useful but have no target."
  },
  "discarded_categories": [
    {
      "category": "character",
      "count": 2751,
      "reason": "Named character identity. Excluded by the protocol and never inferred."
    },
    {
      "category": "demographic-and-identity",
      "examples": [
        "dark_skin",
        "dark-skinned_female",
        "dark-skinned_male"
      ],
      "reason": "Demographic and identity inference is excluded by the protocol and by research/02. People labels are counts only."
    },
    {
      "category": "body-and-sexualised-descriptors",
      "examples": [
        "breasts",
        "large_breasts"
      ],
      "reason": "Not cinematography, and excluded vocabulary. The rating output is the separate sensitive-content lane."
    },
    {
      "category": "character-appearance",
      "examples": [
        "long_hair",
        "blue_eyes",
        "blonde_hair",
        "school_uniform",
        "blush",
        "smile"
      ],
      "reason": "Describes who is in frame rather than how it is shot. The bulk of the general vocabulary by tag count."
    },
    {
      "category": "series-and-copyright",
      "count": 0,
      "reason": "This checkpoint predicts no copyright or series tags at all, so Shoko remains the sole source of series metadata by construction rather than by policy. Recorded here so a later checkpoint that does emit them is culled without re-deriving the rule."
    },
    {
      "category": "illustration-artifacts",
      "examples": [
        "watermark",
        "signature",
        "logo",
        "copyright_name"
      ],
      "reason": "Artifacts of the illustrations WD was trained on. Rare in broadcast frames and never a product facet."
    }
  ],
  "gender_handling": {
    "rule": "Count tags are read for arity only; the gender assertion is dropped at this boundary and never reaches a record.",
    "detail": "The most frequent count vocabulary is inherently gendered (1girl, 1boy, 2girls). Both 1girl and 1boy map to the people value 'one'. No gender value exists anywhere in visual-taxonomy-v2, so there is nowhere for such a label to go even if it were wanted."
  },
  "deferred": [
    {
      "tags": [
        "letterboxed"
      ],
      "reason": "Real signal with no taxonomy target. Aspect is a source-stream property, and letterboxing alone does not distinguish deliberate matting from a frame caught mid-transition between mattes."
    },
    {
      "tags": [
        "classroom",
        "forest",
        "beach",
        "city",
        "mountain",
        "rooftop"
      ],
      "reason": "The research location hierarchy did not enter visual-taxonomy-v2, which carries only interior/exterior/mixed/abstract. These are allowlisted below as corroborating evidence for that axis, not as labels in their own right."
    },
    {
      "tags": [
        "pov",
        "fisheye",
        "perspective",
        "from_side",
        "from_behind"
      ],
      "reason": "from_side and from_behind describe subject-relative direction, not camera height or tilt, so they do not belong to the angle family. The others have no taxonomy value."
    }
  ],
