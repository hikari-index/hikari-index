  "text_evidence": {
    "tags": [
      "subtitled",
      "credits",
      "english_text",
      "japanese_text",
      "text",
      "text_focus",
      "copyright_name",
      "character_name",
      "artist_name",
      "logo"
    ],
    "role": "review-trigger",
    "reason": "Establishes that text is present. Combined with a low frame entropy it also backs text-only-card: a card is type on a flat field and an overlay has content underneath. Above that entropy nothing separates a card from diegetic text, which research/01 forbids removing, so only the low side is acted on. Measured over 3,190 real frames, this list had been written against Danbooru vocabulary rather than what the model emits -- `text` and `japanese_text` fire on ZERO frames while `text_focus` fires on 73, the largest text signal present, and was absent. Added with copyright_name, character_name, artist_name and logo, which carry the name and title cards. watermark and signature stay out as ambiguous on screencaps."
  }
