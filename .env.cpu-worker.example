# .env.cpu-worker: read by compose.cpu-worker.yaml only (a CPU analyze
# worker on a second machine; https://docs.hikari-index.moe/install/second-machine/), passed as --env-file. Copy to `.env.cpu-worker`
# (git-ignored) and fill in.
#
# The gallery, by IP.
HIKARI_GALLERY_URL=http://192.0.2.10:5183
# This machine's own token: the gallery's HIKARI_WORKER_TOKENS holds it as
# "<HIKARI_WORKER_ID>:<token>" (32+ random characters, for example from
# `openssl rand -hex 32`; good only for that name).
HIKARI_WORKER_TOKEN=change-me-to-this-workers-token
# This worker's name on the Jobs page.
HIKARI_WORKER_ID=standby
# "1": take a stage only while no regular analyze worker has checked in
# for ten minutes (a fallback for a GPU machine that is sometimes off).
# Leave it out if this is your only analyze worker.
HIKARI_WORKER_STANDBY=1
# Which published image to run: the same HIKARI_VERSION as the main
# machine (`latest` when left out, or a release number such as 1.0.0).
# HIKARI_VERSION=latest
# Only to pull from a registry of yours instead of ghcr.io: the image is
# then <HIKARI_IMAGE_REPOSITORY>:<HIKARI_VERSION>.
# HIKARI_IMAGE_REPOSITORY=registry.example/hikari-index/cpu-worker
