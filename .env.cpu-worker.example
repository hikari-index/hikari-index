# .env.cpu-worker: read by compose.cpu-worker.yaml only (the standby CPU
# analyze worker), passed as --env-file. Copy to `.env.cpu-worker`
# (git-ignored) and fill in.
#
# The gallery, by IP.
HIKARI_GALLERY_URL=http://192.0.2.10:5183
# This machine's own token: the gallery's HIKARI_WORKER_TOKENS holds it as
# "<HIKARI_WORKER_ID>:<token>" (32+ random characters, for example from
# `openssl rand -hex 32`; good only for that name).
HIKARI_WORKER_TOKEN=change-me-to-this-workers-token
# This worker's name on the Jobs page.
HIKARI_WORKER_ID=standby
# Where the image is and which tag: <HIKARI_IMAGE_REPOSITORY>:<HIKARI_WORKER_VERSION>.
HIKARI_IMAGE_REPOSITORY=ghcr.io/<owner>/hikari-index
HIKARI_WORKER_VERSION=cpu-worker-COMMIT-DATE.1
