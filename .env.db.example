# .env.db: read by compose.db.yaml only (a database for gallery
# development), passed as --env-file. Copy to `.env.db` (git-ignored) and
# fill in. The gallery dev server needs the same password inside
# gallery/.env: DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/NAME
# An install does not use this file; compose.yaml reads `.env`
# (see .env.example).
HIKARI_DB_NAME=hikari
HIKARI_DB_USER=hikari
HIKARI_DB_PASSWORD=change-me
# Loopback only; the dev server runs on the same machine.
HIKARI_DB_BIND=127.0.0.1
HIKARI_DB_PORT=5432
